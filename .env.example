# Standalone host settings
PORT=8080

# Azure OpenAI configuration for the standalone API (authenticate with az login)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Microsoft Foundry hosted agent configuration (authenticate with az login)
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1
