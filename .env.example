# Local host port override (Foundry defaults to 8088; docker-compose forces standalone to 8080)
PORT=8088

# Azure OpenAI configuration for the standalone API (authenticate with az login)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Microsoft Foundry hosted agent configuration (authenticate with az login)
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1

# Local development uses az login or service principal credentials by default.
# Set to true only when running on Azure infrastructure with managed identity enabled.
USE_MANAGED_IDENTITY=false
