{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "AZURE_LOCATION": {
      "value": "eastus2"
    },
    "CONTAINER_APP_NAME": {
      "value": "claims-foundry-agent"
    },
    "CONTAINER_APPS_ENVIRONMENT_NAME": {
      "value": "claims-foundry-env"
    },
    "LOG_ANALYTICS_WORKSPACE_NAME": {
      "value": "claims-foundry-logs"
    },
    "MANAGED_IDENTITY_NAME": {
      "value": "claims-foundry-agent-mi"
    },
    "CONTAINER_IMAGE": {
      "value": "example.azurecr.io/claims-foundry-agent:latest"
    },
    "CONTAINER_REGISTRY_SERVER": {
      "value": "example.azurecr.io"
    },
    "CONTAINER_REGISTRY_NAME": {
      "value": "claimsregistry"
    },
    "FOUNDRY_PROJECT_ENDPOINT": {
      "value": "https://your-project.services.ai.azure.com/api/projects/your-project"
    },
    "AZURE_AI_MODEL_DEPLOYMENT_NAME": {
      "value": "gpt-4.1"
    },
    "OPENAI_ACCOUNT_NAME": {
      "value": "your-openai-account"
    },
    "CONTAINER_CPU": {
      "value": 1
    },
    "CONTAINER_MEMORY": {
      "value": "2Gi"
    }
  }
}
